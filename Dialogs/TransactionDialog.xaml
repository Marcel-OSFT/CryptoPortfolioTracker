<local:BaseDialog
    x:Class="CryptoPortfolioTracker.Dialogs.TransactionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CryptoPortfolioTracker.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:converters="using:CryptoPortfolioTracker.Converters"
    xmlns:controls="using:CryptoPortfolioTracker.Controls"
    xmlns:l="using:WinUI3Localizer"
    xmlns:ext="using:CommunityToolkit.WinUI"
    CloseButtonClick="CloseButton_Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="PrimaryButton_AcceptTransaction"
    x:Name="Root"
    IsPrimaryButtonEnabled="{x:Bind Validator.IsAllEntriesValid, Mode=TwoWay}">

    <local:BaseDialog.Resources>
        <converters:FormatValueToString x:Key="FormatValueToString"/>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">1200</x:Double>
        <x:Double x:Key="RadioButtonCheckGlyphSize">12</x:Double>
        <x:Double x:Key="RadioButtonCheckGlyphPointerOverSize">14</x:Double>
        <x:Double x:Key="RadioButtonCheckGlyphPressedOverSize">10</x:Double>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="15" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        
        <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SubtleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </local:BaseDialog.Resources>

    <ScrollViewer MaxHeight="780" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Width="820" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="1" CornerRadius="18" Padding="10" Margin="0,0,0,10">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.14" />
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.35" />
                </Border.BorderBrush>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind DialogTitle}" Style="{StaticResource HeaderTitleStyle}" VerticalAlignment="Center" Margin="0,0,0,-2" />
                        <RadioButtons l:Uids.Uid="TransactionDialog_TransactionType" x:Name="TransactionTypeRadioButtons" TabIndex="0" Width="710" MaxColumns="6" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,-4,0,-2" SelectionChanged="TransactionType_SelectionChanged">
                            <RadioButton l:Uids.Uid="TransactionType_Deposit"  Margin="0,0,0,0"/>
                            <RadioButton l:Uids.Uid="TransactionType_Withdraw" Margin="-10,0,0,0"/>
                            <RadioButton l:Uids.Uid="TransactionType_Transfer" Margin="-20,0,0,0"/>
                            <RadioButton l:Uids.Uid="TransactionType_Convert"  Margin="-30,0,0,0"/>
                            <RadioButton l:Uids.Uid="TransactionType_Buy"      Margin="-40,0,0,0"/>
                            <RadioButton l:Uids.Uid="TransactionType_Sell"     Margin="-50,0,0,0"/>
                        </RadioButtons>
                    </StackPanel>

                    <Border Grid.Column="1" Width="120" Height="70" Padding="5,5" CornerRadius="12" BorderThickness="1" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.45" />
                        </Border.BorderBrush>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Selected type" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind SelectedTypeDisplay, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="10" Margin="0,0,0,10" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="390" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="380" HorizontalAlignment="Left" Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="From" Style="{StaticResource SectionTitleStyle}" />

                        <controls:AutoSuggestBoxWithValidation x:Name="ASBoxCoinA" Margin="12,0,0,0"
                            TabIndex="1"
                            ItemsSource="{x:Bind ListCoinA, Mode=TwoWay}"
                            MyText="{x:Bind CoinA, Mode=TwoWay}"
                            Header="{x:Bind HeaderCoinA}"
                            IsEntryMatched="{x:Bind Validator.EntryCollection[0], Mode=TwoWay}"
                            TextChanged="ASBoxCoinA_TextChanged"
                            SuggestionChosen="ASBoxCoinA_SuggestionChosen"
                            AnimateBorder="True"
                            Width="330"
                            HorizontalAlignment="Left" />

                        <controls:AutoSuggestBoxWithValidation x:Name="ASBoxAccountFrom" Margin="12,12,0,0"
                            TabIndex="3"
                            ItemsSource="{x:Bind ListAccountFrom, Mode=TwoWay}"
                            MyText="{x:Bind AccountFrom, Mode=TwoWay}"
                            Header="{x:Bind HeaderAccountFrom}"
                            IsEntryMatched="{x:Bind Validator.EntryCollection[2], Mode=TwoWay}"
                            TextChanged="ASBoxAccountFrom_TextChanged"
                            SuggestionChosen="ASBoxAccountFrom_SuggestionChosen"
                            AnimateBorder="True"
                            Width="330"
                            HorizontalAlignment="Left" />

                        <Grid Margin="0,10,0,8" Width="540" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>

                            <controls:RegExTextBox x:Name="TBoxQtyA" TabIndex="5" Margin="12,0,0,0"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                RegEx="RegExPositiveDecimal"
                                IsZeroAllowed="False"
                                DecimalSeparator="{x:Bind DecimalSeparator, Mode=OneWay}"
                                Text="{x:Bind QtyA, Mode=TwoWay, Converter={StaticResource FormatValueToString}, ConverterParameter='{}{0:0.########}'}"
                                Header="{x:Bind converters:Functions.FormatMaxQtyA(MaxQtyA), Mode=OneWay}"
                                IsEntryValid="{x:Bind Validator.EntryCollection[4], Mode=TwoWay}"
                                Style="{StaticResource MK_TextBoxStyle}"
                                PointerPressed="QtyOrPrice_pressed"
                                LostFocus="TBoxQtyA_LostFocus"
                                Width="160" />

                            <controls:RegExTextBox l:Uids.Uid="TransactionDialog_PriceA" x:Name="TBoxPriceA" TabIndex="6" Margin="0,0,0,0"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                RegEx="RegExPositiveDecimal"
                                IsZeroAllowed="{x:Bind IsEarnings}"
                                DecimalSeparator="{x:Bind DecimalSeparator, Mode=OneWay}"
                                IsEnabled="{x:Bind converters:Functions.InvertBool(Earnings.IsChecked), Mode=OneWay}"
                                Text="{x:Bind PriceA, Mode=TwoWay, Converter={StaticResource FormatValueToString}, ConverterParameter='{}{0:0.##################}'}"
                                IsEntryValid="{x:Bind Validator.EntryCollection[5], Mode=TwoWay}"
                                Style="{StaticResource MK_TextBoxStyle}"
                                Width="150"
                                TextChanged="TBoxPriceA_TextChanged"
                                PointerPressed="QtyOrPrice_pressed"
                                ToolTipService.ToolTip="The price of the underlying coin" />
                            
                            
                        </Grid>

                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <AppBarButton Label="" Click="LinkAccountsButton_Click" x:Name="LinkAccountsButton" l:Uids.Uid="TransactionDialog_AccountLink"
                        Style="{StaticResource MK_AppBarButtonStyle}"
                        Opacity="{x:Bind converters:Functions.TrueToOpacityOne(IsAccountsLinked), Mode=OneWay}"
                        Margin="-3,30,0,0">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE71B;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    
                </Grid>
                
                    <CheckBox x:Name="Earnings" l:Uids.Uid="TransactionDialog_Earnings"
                        Grid.Column="2"
                        Margin="0,0,0,0"
                        VerticalContentAlignment="Center"
                        IsChecked="{x:Bind IsEarnings, Mode=TwoWay}"
                        Visibility="{x:Bind EarningsCheckBoxVisibility}"/>  
                
                <Border x:Name="ToCard" Grid.Column="2" Width="380" HorizontalAlignment="Left" Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ToCardTitle" Text="To" Style="{StaticResource SectionTitleStyle}" />

                        <controls:AutoSuggestBoxWithValidation x:Name="ASBoxCoinB" Margin="12,0,0,0"
                            TabIndex="2"
                            ItemsSource="{x:Bind ListCoinB, Mode=TwoWay}"
                            MyText="{x:Bind CoinB, Mode=TwoWay}"
                            Header="{x:Bind HeaderCoinB}"
                            IsEntryMatched="{x:Bind Validator.EntryCollection[1], Mode=TwoWay}"
                            AnimateBorder="True"
                            Width="330"
                            HorizontalAlignment="Left" />

                        <controls:AutoSuggestBoxWithValidation x:Name="ASBoxAccountTo" Margin="12,12,0,0"
                            TabIndex="4"
                            ItemsSource="{x:Bind ListAccountTo, Mode=TwoWay}"
                            MyText="{x:Bind AccountTo, Mode=TwoWay}"
                            Header="{x:Bind HeaderAccountTo}"
                            IsEntryMatched="{x:Bind Validator.EntryCollection[3], Mode=TwoWay}"
                            IsEnabled="{x:Bind converters:Functions.InvertBool(IsAccountsLinked), Mode=OneWay}"
                            AnimateBorder="True"
                            Width="330"
                            HorizontalAlignment="Left" />

                        <Grid x:Name="QtyAndPriceSelectionB" Margin="0,10,0,8" Width="540" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>

                            <controls:RegExTextBox l:Uids.Uid="TransactionDialog_QtyB" x:Name="TBoxQtyB" TabIndex="7" Margin="12,0,0,0"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                RegEx="RegExPositiveDecimal"
                                IsZeroAllowed="False"
                                DecimalSeparator="{x:Bind DecimalSeparator, Mode=OneWay}"
                                Text="{x:Bind QtyB, Mode=TwoWay, Converter={StaticResource FormatValueToString}, ConverterParameter='{}{0:0.########}'}"
                                IsEntryValid="{x:Bind Validator.EntryCollection[6], Mode=TwoWay}"
                                Style="{StaticResource MK_TextBoxStyle}"
                                PointerPressed="QtyOrPrice_pressed"
                                Width="160" />

                            <controls:RegExTextBox l:Uids.Uid="TransactionDialog_PriceB" x:Name="TBoxPriceB" TabIndex="8" Margin="0,0,0,0"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                RegEx="RegExPositiveDecimal"
                                IsZeroAllowed="False"
                                DecimalSeparator="{x:Bind DecimalSeparator, Mode=OneWay}"
                                Text="{x:Bind PriceB, Mode=TwoWay, Converter={StaticResource FormatValueToString}, ConverterParameter='{}{0:0.########}'}"
                                IsEntryValid="{x:Bind Validator.EntryCollection[7], Mode=TwoWay}"
                                Style="{StaticResource MK_TextBoxStyle}"
                                Width="150"
                                IsEnabled="False" />
                        </Grid>
                    </StackPanel>
                </Border>
                
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Margin="0,0,0,10">
                <StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="137" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="290" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:RegExTextBox x:Name="TBoxQtyFee" TabIndex="9"
                            Grid.Column="0"
                            RegEx="RegExPositiveDecimal"
                            IsZeroAllowed="True"
                            DecimalSeparator="{x:Bind DecimalSeparator, Mode=OneWay}"
                            Text="{x:Bind FeeQty, Mode=TwoWay, Converter={StaticResource FormatValueToString}, ConverterParameter='{}{0:0.########}'}"
                            IsEntryValid="{x:Bind Validator.EntryCollection[8], Mode=TwoWay}"
                            Style="{StaticResource MK_TextBoxStyle}"
                            PointerPressed="QtyOrPrice_pressed"
                            Header="Fee"
                            Width="120" />

                        <controls:AutoSuggestBoxWithValidation x:Name="ASBoxFeeCoin"
                            Grid.Column="1"
                            TabIndex="10"
                            ItemsSource="{x:Bind ListFeeCoin, Mode=TwoWay}"
                            MyText="{x:Bind FeeCoin, Mode=TwoWay}"
                            IsEntryMatched="{x:Bind Validator.EntryCollection[9], Mode=TwoWay}"
                            AnimateBorder="True"
                            Header="Fee asset"
                            Width="180" />

                        <DatePicker x:Name="DatePicker" l:Uids.Uid="TransactionDialog_DatePicker" Grid.Column="2" TabIndex="11" Margin="90,0,0,0" Date="{x:Bind Date, Mode=TwoWay}" Style="{StaticResource MK_DatePickerStyle}" />
                        <TimePicker x:Name="TimePicker" Header=" " Grid.Column="3" TabIndex="12" Margin="0,0,0,0" Time="{x:Bind Time, Mode=TwoWay}" ClockIdentifier="24HourClock" Style="{StaticResource MK_TimePickerStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="Notes" Style="{StaticResource SectionTitleStyle}" />
                    <TextBox x:Name="TBoxNote" TabIndex="13"
                        Width="742"
                        Height="60"
                        Text="{x:Bind Note, Mode=TwoWay}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        Style="{StaticResource MK_TextBoxStyle}"
                        PlaceholderText="Add a short note about the transaction" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</local:BaseDialog>
    