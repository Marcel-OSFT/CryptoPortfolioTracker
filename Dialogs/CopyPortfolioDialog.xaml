<local:BaseDialog
    x:Class="CryptoPortfolioTracker.Dialogs.CopyPortfolioDialog"
    Title="Rename Portfolio"
    PrimaryButtonText="Save"
    PrimaryButtonClick="Button_Click_Accept"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:CryptoPortfolioTracker.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel
        Width="480"
        Spacing="14">

        <!-- Portfolio name -->
        <Border
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <StackPanel Spacing="10">
                <TextBlock
                    l:Uids.Uid="CopyPortfolioDialog_NameHeader"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <TextBox
                    x:Name="txtName"
                    LosingFocus="PortfolioName_LosingFocus"
                    TextChanging="PortfolioName_TextChanging" />
            </StackPanel>
        </Border>

        <!-- Copy options -->
        <Border
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <StackPanel Spacing="12">
                <TextBlock
                    l:Uids.Uid="CopyPortfolioDialog_CopyOptions"
                    TextWrapping="Wrap"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <RadioButtons
                    SelectionChanged="CopyOptions_SelectionChanged">

                    <RadioButton
                        l:Uids.Uid="CopyPortfolioDialog_RbFullCopy"
                        IsChecked="True" />

                    <RadioButton
                        l:Uids.Uid="CopyPortfolioDialog_RbPartialCopy"
                        IsChecked="False" />

                </RadioButtons>
            </StackPanel>
        </Border>

    </StackPanel>
</local:BaseDialog>