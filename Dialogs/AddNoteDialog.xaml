<local:BaseDialog
    x:Class="CryptoPortfolioTracker.Dialogs.AddNoteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:local="using:CryptoPortfolioTracker.Dialogs" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    DefaultButton="Primary"
    xmlns:l="using:WinUI3Localizer"
    PrimaryButtonClick="Button_Click_AcceptNote">

    <local:BaseDialog.Resources>
        <!-- Overriding ContentDialogMaxWidth value -->
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
    </local:BaseDialog.Resources>

    <Grid MinWidth="400" MaxWidth="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Description -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock
            l:Uids.Uid="NoteDialog_NoteHeader"
            Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <TextBlock
            l:Uids.Uid="NoteDialog_Note_Explain"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap"
            Opacity="0.75"/>

            <TextBox
            l:Uids.Uid="NoteDialog_Note"
            x:Name="NoteText"
         
            AutomationProperties.Name="Note"
            TextWrapping="Wrap"
            AcceptsReturn="True"
            VerticalAlignment="Stretch"
            MinHeight="120"
            MaxHeight="200"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollMode="Auto"/>
        </StackPanel>
    </Grid>


</local:BaseDialog>
