<local:BaseDialog
    x:Class="CryptoPortfolioTracker.Dialogs.AssignNarrativeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CryptoPortfolioTracker.Dialogs"
    xmlns:l="using:WinUI3Localizer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    x:Name="Root"
    DefaultButton="Primary"
    PrimaryButtonClick="Button_Click_AcceptNarrative">

    <local:BaseDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
    </local:BaseDialog.Resources>

    <StackPanel
        Width="520"
        Spacing="14">

        <!-- Narrative selection -->
        <Border
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <StackPanel Spacing="10">
                <TextBlock
                    l:Uids.Uid="AssignNarrativeDialog_ComboHeader"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <ComboBox
                    x:Name="cbNarratives"
                    MinWidth="200"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind Narratives}"
                    DisplayMemberPath="Name"
                    SelectedItem="{x:Bind SelectedNarrative, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <!-- Narrative description -->
        <Border
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <StackPanel Spacing="10">
                <TextBlock
                    l:Uids.Uid="AssignNarrativeDialog_DescriptionHeader"
                    Text="Description"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <ScrollViewer
                    MaxHeight="180"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <TextBlock
                        x:Name="DescriptionText"
                        Text="{x:Bind About, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Border>

    </StackPanel>
</local:BaseDialog>
