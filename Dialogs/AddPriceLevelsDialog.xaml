<local:BaseDialog
    x:Class="CryptoPortfolioTracker.Dialogs.AddPriceLevelsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CryptoPortfolioTracker.Dialogs"
    xmlns:controls="using:CryptoPortfolioTracker.Controls"
    xmlns:converters="using:CryptoPortfolioTracker.Converters"
    xmlns:l="using:WinUI3Localizer"
    x:Name="Root"
    DefaultButton="Primary"
    PrimaryButtonClick="Button_Click_Accept">

    <local:BaseDialog.Resources>
        <converters:FormatValueToString x:Key="FormatValueToString"/>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
    </local:BaseDialog.Resources>

    <ContentDialog.PrimaryButtonStyle>
        <StaticResource ResourceKey="AccentButtonStyle" />
    </ContentDialog.PrimaryButtonStyle>

    <StackPanel
        Width="460"
        Spacing="14">

        <!-- Take Profit card -->
        <Border
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <StackPanel Spacing="10">
                <TextBlock
                    l:Uids.Uid="PriceLevelsDialog_TpHeaderSection"
                    x:Name="txtTPSection"
                    Style="{StaticResource BodyStrongTextBlockStyle}"/>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock
                        l:Uids.Uid="PriceLevelsDialog_TpHeader"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.8"/>

                        <controls:RegExTextBox
                        l:Uids.Uid="PriceLevelsDialog_TpValue"
                        x:Name="regTpValue"
                        RegEx="RegExPositiveDecimal"
                        IsZeroAllowed="True"
                        DecimalSeparator="{x:Bind DecimalSeparator, Mode=OneWay}"
                        Text="{x:Bind TpValue, Mode=TwoWay, Converter={StaticResource FormatValueToString}, ConverterParameter='{}{0:0.########}'}"
                        Style="{StaticResource MK_TextBoxStyle}"
                        Width="180"
                        HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock
                        l:Uids.Uid="PriceLevelsDialog_NoteHeader"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.8"/>

                        <TextBox
                        l:Uids.Uid="PriceLevelsDialog_Note"
                        x:Name="txtTPNote"
                        Text="{x:Bind TpNote, Mode=TwoWay}"
                        AutomationProperties.Name="Take profit note"
                        TextWrapping="Wrap" 
                        AcceptsReturn="True"
                        MinHeight="64"
                        MaxHeight="100"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Buy Level card -->
        <Border
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <StackPanel Spacing="10">
                <TextBlock
                    l:Uids.Uid="PriceLevelsDialog_BuyHeaderSection"
                    x:Name="txtBuySection"
                    Style="{StaticResource BodyStrongTextBlockStyle}"/>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock
                        l:Uids.Uid="PriceLevelsDialog_BuyHeader"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.8"/>

                        <controls:RegExTextBox
                        l:Uids.Uid="PriceLevelsDialog_BuyValue"
                        x:Name="regBuyValue"
                        RegEx="RegExPositiveDecimal"
                        IsZeroAllowed="True"
                        DecimalSeparator="{x:Bind DecimalSeparator, Mode=OneWay}"
                        Text="{x:Bind BuyValue, Mode=TwoWay, Converter={StaticResource FormatValueToString}, ConverterParameter='{}{0:0.########}'}"
                        Style="{StaticResource MK_TextBoxStyle}"
                        Width="180"
                        HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock
                        l:Uids.Uid="PriceLevelsDialog_NoteHeader"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.8"/>

                        <TextBox
                        l:Uids.Uid="PriceLevelsDialog_Note"
                        x:Name="txtBuyNote"
                        Text="{x:Bind BuyNote, Mode=TwoWay}"
                        AutomationProperties.Name="Buy level note"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MinHeight="64"
                        MaxHeight="100"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Stop Level card -->
        <Border
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <StackPanel Spacing="10">
                <TextBlock
                    l:Uids.Uid="PriceLevelsDialog_StopHeaderSection"
                    x:Name="txtStopSection"
                    Style="{StaticResource BodyStrongTextBlockStyle}"/>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock
                        l:Uids.Uid="PriceLevelsDialog_StopHeader"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.8"/>

                        <controls:RegExTextBox
                        l:Uids.Uid="PriceLevelsDialog_StopValue"
                        x:Name="regStopValue"
                        RegEx="RegExPositiveDecimal"
                        IsZeroAllowed="True"
                        DecimalSeparator="{x:Bind DecimalSeparator, Mode=OneWay}"
                        Text="{x:Bind StopValue, Mode=TwoWay, Converter={StaticResource FormatValueToString}, ConverterParameter='{}{0:0.########}'}"
                        Style="{StaticResource MK_TextBoxStyle}"
                        Width="180"
                        HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock
                        l:Uids.Uid="PriceLevelsDialog_NoteHeader"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.8"/>

                        <TextBox
                        l:Uids.Uid="PriceLevelsDialog_Note"
                        x:Name="txtStopNote"
                        Text="{x:Bind StopNote, Mode=TwoWay}"
                        AutomationProperties.Name="Stop level note"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MinHeight="64"
                        MaxHeight="100"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</local:BaseDialog>
