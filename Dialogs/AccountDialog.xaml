<local:BaseDialog
    x:Class="CryptoPortfolioTracker.Dialogs.AccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CryptoPortfolioTracker.Dialogs"
    xmlns:l="using:WinUI3Localizer"
    Title="Add a new Account"
    DefaultButton="Primary"
    PrimaryButtonClick="Button_Click_AcceptAccount">

    <local:BaseDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
    </local:BaseDialog.Resources>

    <Grid MinWidth="400" MaxWidth="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Account name -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,4,0,20">
            <TextBlock
                l:Uids.Uid="AccountDialog_NameHeader"
                Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <TextBox
                l:Uids.Uid="AccountDialog_Name"
                x:Name="txtAccountName"
                TextChanging="AccountName_TextChanging"
                LosingFocus="AccountName_LosingFocus"
                HorizontalAlignment="Stretch"
                MinWidth="0"/>
        </StackPanel>

        <!-- Description -->
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock
                l:Uids.Uid="AccountDialog_DescriptionHeader"
                Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <TextBlock
                l:Uids.Uid="AccountDialog_Description_Explain"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Opacity="0.75"/>

            <TextBox
                l:Uids.Uid="AccountDialog_Description"
                x:Name="DescriptionText"
             
                AutomationProperties.Name="Account description"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                VerticalAlignment="Stretch"
                MinHeight="120"
                MaxHeight="200"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Auto"/>
        </StackPanel>
    </Grid>

</local:BaseDialog>

