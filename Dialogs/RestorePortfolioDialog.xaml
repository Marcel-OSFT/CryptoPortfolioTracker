<local:BaseDialog
    x:Class="CryptoPortfolioTracker.Dialogs.RestorePortfolioDialog"
    Title="Restore a backup"
    PrimaryButtonText="Save"
    PrimaryButtonClick="Button_Click_Accept"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:CryptoPortfolioTracker.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <StackPanel
        Width="520"
        Spacing="14">

        <!-- Backup file selection -->
        <Border
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <StackPanel Spacing="12">

                <TextBlock
                    x:Name="txtSelectFile"
                    l:Uids.Uid="RestorePortfolioDialog_FileHeader"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        l:Uids.Uid="RestorePortfolioDialog_FileName"
                        x:Name="txtFilename"
                        Grid.Column="0"
                        Text="{x:Bind FileName, Mode=OneWay}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        FontSize="14"
                        FontStyle="Oblique" />

                    <Button
                        l:Uids.Uid="RestorePortfolioDialog_BrowseButton"
                        x:Name="btnBrowse"
                        Grid.Column="1"
                        Command="{x:Bind BrowseCommand}"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Restore information -->
        <Border
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <StackPanel Spacing="12">

                <TextBlock
                    x:Name="txtExplanation"
                    Text="{x:Bind Explanation, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <TextBlock
                    l:Uids.Uid="AccountDialog_NameHeader"
                    Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock
                    x:Name="txtName"
                    Text="{x:Bind PortfolioName, Mode=OneWay}"
                    TextWrapping="Wrap"
                    FontSize="16"
                    FontStyle="Oblique" />

            </StackPanel>
        </Border>

    </StackPanel>
</local:BaseDialog>