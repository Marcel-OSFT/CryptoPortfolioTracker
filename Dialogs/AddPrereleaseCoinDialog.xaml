
<local:BaseDialog
    x:Class="CryptoPortfolioTracker.Dialogs.AddPrereleaseCoinDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CryptoPortfolioTracker.Dialogs"
    xmlns:controls="using:CryptoPortfolioTracker.Controls"
    xmlns:l="using:WinUI3Localizer"
    x:Name="Root"
    DefaultButton="Primary"
    PrimaryButtonClick="Button_Click_AcceptCoin">

    <local:BaseDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
    </local:BaseDialog.Resources>

    <Grid MinWidth="400" MaxWidth="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Explanation -->
        <TextBlock
            Grid.Row="0"
            l:Uids.Uid="PreListingCoinDialog_Explainer"
            TextWrapping="Wrap"
            Margin="0,0,0,24"
            Style="{StaticResource BodyTextBlockStyle}"/>

        <!-- Coin identity -->
        <StackPanel
            Grid.Row="1"
            Spacing="6"
            Margin="0,0,0,20">

            <TextBlock
                l:Uids.Uid="PreListingCoinDialog_NameHeader"
                Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <TextBox
                x:Name="CoinName"
                l:Uids.Uid="PreListingCoinDialog_Name"
                HorizontalAlignment="Stretch"
                TextChanging="CoinName_TextChanging"/>
        </StackPanel>

        <!-- Symbol and initial price -->
        <StackPanel
            Grid.Row="2"
            Spacing="6"
            Margin="0,0,0,20">

            <TextBlock
                l:Uids.Uid="PreListingCoinDialog_SymbolPriceHeader"
                Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Spacing="4">

                    <TextBlock
                        l:Uids.Uid="PreListingCoinDialog_SymbolHeader"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.8"/>

                    <TextBox
                        x:Name="CoinSymbol"
                        l:Uids.Uid="PreListingCoinDialog_Symbol"
                        TextChanging="CoinSymbol_TextChanging"/>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Spacing="4">

                    <TextBlock
                        l:Uids.Uid="PreListingCoinDialog_PriceHeader"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.8"/>

                    <controls:RegExTextBox
                        x:Name="CoinPrice"
                        l:Uids.Uid="PreListingCoinDialog_Price"
                        RegEx="RegExPositiveDecimal"
                        IsZeroAllowed="True"
                        DecimalSeparator="{Binding DecimalSeparator, ElementName=Root, Mode=OneWay}"
                        IsEnabled="True"
                        Text="0"
                        IsEntryValid="False"
                        Style="{StaticResource MK_TextBoxStyle}"
                        TextChanged="CoinPrice_Changed"
                        HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- About the coin -->
        <StackPanel
            Grid.Row="3"
            Spacing="6">

            <TextBlock
                l:Uids.Uid="PreListingCoinDialog_AboutHeader"
                Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <TextBlock
                l:Uids.Uid="PreListingCoinDialog_AboutExplain"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Opacity="0.75"/>

            <TextBox
                x:Name="CoinAbout"
                l:Uids.Uid="PreListingCoinDialog_About"
                AutomationProperties.Name="Coin description"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                MinHeight="100"
                MaxHeight="180"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Auto"/>
        </StackPanel>
    </Grid>
</local:BaseDialog>
   
