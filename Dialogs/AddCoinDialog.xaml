<local:BaseDialog
    x:Class="CryptoPortfolioTracker.Dialogs.AddCoinDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CryptoPortfolioTracker.Dialogs"
    xmlns:controls="using:CryptoPortfolioTracker.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    x:Name="Root"
    DefaultButton="Primary"
    PrimaryButtonClick="Button_Click_AddCoin">

    <local:BaseDialog.Resources>
        <x:Double x:Key="ContentDialogWidth">560</x:Double>
        <x:Double x:Key="SectionWidth">490</x:Double>
        <x:Double x:Key="DetailFontSize">18</x:Double>
    </local:BaseDialog.Resources>

    <StackPanel
        Width="{StaticResource ContentDialogWidth}"
        Spacing="14">

        <!-- Coin search -->
        <Border
            HorizontalAlignment="Left"
            Width="{StaticResource SectionWidth}"
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <StackPanel Spacing="10">

                <TextBlock
                    l:Uids.Uid="CoinDialog_SearchBoxHeader"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <controls:AutoSuggestBoxWithValidation
                    x:Name="ASBox"
                    l:Uids.Uid="CoinDialog_SearchBox"
                    ItemsSource="{x:Bind CoinList}"
                    MyText="{x:Bind CoinName, Mode=TwoWay}"
                    SuggestionChosen="AutoSuggestBox_SuggestionChosen"
                    KeyDown="AutoSuggestBox_KeyDown"
                    AnimateBorder="True"
                    HorizontalAlignment="Stretch"
                    TabIndex="0" />

            </StackPanel>
        </Border>

        <!-- Coin details and API status -->
        <Border
            HorizontalAlignment="Left"
            Width="{StaticResource SectionWidth}"
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <Grid
                x:Name="DetailsGrid"
                RowSpacing="16">

                <Grid x:Name="DetailsContent">

                    <!-- Coin image -->
                    <Border
                        Grid.Column="0"
                        Width="88"
                        Height="88"
                        CornerRadius="8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

                        <Image
                            x:Name="CoinImage"
                            Width="80"
                            Height="80"
                            Stretch="Uniform" />
                    </Border>

                    <!-- Coin information -->
                    
                    <RichTextBlock
                        Grid.Column="1"
                        x:Name="CoinInfoText"
                        HorizontalAlignment="Stretch"
                        TextAlignment="Right"
                        TextWrapping="Wrap">

                        <Paragraph TextAlignment="Right">
                            <Run
                                l:Uids.Uid="CoinDialog_Id"
                                FontSize="12"
                                FontStyle="Italic"
                                TextDecorations="Underline" />
                        </Paragraph>
                        <Paragraph
                            x:Name="parId"
                            TextAlignment="Right"
                            FontSize="{StaticResource DetailFontSize}"
                            Margin="0,0,0,10" />

                        <Paragraph TextAlignment="Right">
                            <Run
                                l:Uids.Uid="CoinDialog_Name"
                                FontSize="12"
                                FontStyle="Italic"
                                TextDecorations="Underline" />
                        </Paragraph>
                        <Paragraph
                            x:Name="parName"
                            TextAlignment="Right"
                            FontSize="{StaticResource DetailFontSize}"
                            Margin="0,0,0,10" />

                        <Paragraph TextAlignment="Right">
                            <Run
                                l:Uids.Uid="CoinDialog_Symbol"
                                FontSize="12"
                                FontStyle="Italic"
                                TextDecorations="Underline" />
                        </Paragraph>
                        <Paragraph
                            x:Name="parSymbol"
                            TextAlignment="Right"
                            FontSize="{StaticResource DetailFontSize}"
                            Margin="0,0,0,10" />

                        <Paragraph TextAlignment="Right">
                            <Run
                                l:Uids.Uid="CoinDialog_MarketCapRank"
                                FontSize="12"
                                FontStyle="Italic"
                                TextDecorations="Underline" />
                        </Paragraph>
                        <Paragraph
                            x:Name="parRank"
                            TextAlignment="Right"
                            FontSize="{StaticResource DetailFontSize}"
                            Margin="0,0,0,10" />

                        <Paragraph TextAlignment="Right">
                            <Run
                                l:Uids.Uid="CoinDialog_Price"
                                FontSize="12"
                                FontStyle="Italic"
                                TextDecorations="Underline" />
                        </Paragraph>
                        <Paragraph
                            x:Name="parPrice"
                            TextAlignment="Right"
                            FontSize="{StaticResource DetailFontSize}"
                            Margin="0,0,0,10" />

                    </RichTextBlock>
                </Grid>

                <!-- API loading / delay feedback centered over the details-->
                <Grid
                    x:Name="LoadingOverlay"
                    Canvas.ZIndex="10"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="{x:Bind BePatientVisibility, Mode=OneWay}">

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="280">

                        <ProgressRing
                            x:Name="TheProgressRing"
                            Width="44"
                            Height="44"
                            IsActive="True"
                            HorizontalAlignment="Center" />

                        <TextBlock
                            x:Name="bePatientText"
                            l:Uids.Uid="CoinDialog_BePatient"
                            x:FieldModifier="public"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- Initial narrative -->
        <Border
            HorizontalAlignment="Left"
            Width="{StaticResource SectionWidth}"
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <ComboBox
                x:Name="cbNarratives"
                l:Uids.Uid="CoinDialog_Narrative"
                ItemsSource="{x:Bind Narratives}"
                DisplayMemberPath="Name"
                SelectedItem="{x:Bind InitialNarrative, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                Header="Narrative" />

        </Border>

    </StackPanel>
</local:BaseDialog>
    
