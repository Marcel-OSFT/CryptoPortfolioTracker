<?xml version="1.0" encoding="utf-8"?>
<UserControl    
    x:Class="TemperatureMonitor.Controls.GraphControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TemperatureMonitor.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:viewmodels="using:TemperatureMonitor.ViewModels"
    xmlns:converters="using:TemperatureMonitor.Converters"
    xmlns:helpers="using:TemperatureMonitor.Helpers"
    xmlns:enums="using:TemperatureMonitor.Enums"
    xmlns:ui="using:CommunityToolkit.WinUI"
    x:Name="Root"
    xmlns:l="using:WinUI3Localizer"
    xmlns:toolkit="using:AK.Toolkit.WinUI3"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel}"
    Loading="Control_Loading"
    Loaded="Control_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <RelativePanel Grid.Row="0">
            <TextBlock x:Name="txtTitle"
                l:Uids.Uid="GraphicView" 
                FontSize="16" 
                Margin="0,10,10,0"
                RelativePanel.AlignLeftWithPanel="True" RelativePanel.AlignTopWithPanel="True"/>
            <!-- Zoom mode selector -->
            <StackPanel Orientation="Horizontal" Margin="0,8,10,0" RelativePanel.AlignRightWithPanel="True" RelativePanel.AlignTopWithPanel="True">
                <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbZoomMode" Width="120" SelectionChanged="cmbZoomMode_SelectionChanged">
                    <ComboBoxItem Tag="X" Content="X (time)" />
                    <ComboBoxItem Tag="Y" Content="Y (temperature)" />
                    <ComboBoxItem Tag="XY" Content="Both" />
                </ComboBox>
                <Button x:Name="btnResetZoom" Content="Reset zoom" Click="btnResetZoom_Click" VerticalAlignment="Center"/>
            </StackPanel>

        </RelativePanel>
        <lvc:CartesianChart Grid.Row="1" SizeChanged="Graph_SizeChanged"
            x:Name="thisChart"
            Series="{Binding SeriesGraph}" 
            ZoomMode="X"
            
            XAxes="{Binding XAxesGraph}"
            YAxes="{Binding YAxesGraph}"
            LegendPosition="Bottom"
            LegendTextPaint="{Binding LegendTextPaintGraph}"
            LegendTextSize="{Binding LegendTextSizeGraph}"  
            TooltipTextSize="12"
            >
        </lvc:CartesianChart>

        
    </Grid>


</UserControl>

