<Page
    x:Class="CryptoPortfolioTracker.Views.AdminView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CryptoPortfolioTracker.Models"
    xmlns:viewmodels="using:CryptoPortfolioTracker.ViewModels"
    xmlns:converters="using:CryptoPortfolioTracker.Converters"
    xmlns:helpers="using:CryptoPortfolioTracker.Helpers"
    xmlns:controls="using:CryptoPortfolioTracker.Controls"
    xmlns:l="using:WinUI3Localizer"
    xmlns:toolkit="using:AK.Toolkit.WinUI3"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=viewmodels:AdminViewModel}"
    Loading="Page_Loading"
    mc:Ignorable="d">

    <Page.Resources>

        <Style x:Key="CustomListViewItemsStyle"
               TargetType="ListViewItem"
               BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="13,5,5,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="AdminSectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AdminSectionBorderStyle"
               TargetType="Border">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"
                    Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Background"
                    Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        </Style>

    </Page.Resources>

    <Grid x:Name="MainGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="HeaderGrid" CornerRadius="8,8,0,0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Margin="0,0,5,10" 
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
            <Grid.RowDefinitions>
                <RowDefinition Height="220"/>
                <RowDefinition Height="*" x:Name="Row1"/>
                <RowDefinition Height="0" x:Name="Row2"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!--<ColumnDefinition Width="*"/>-->
            </Grid.ColumnDefinitions>

            <controls:PortfolioHeaderControl
                x:Name="PortfolioHeader"
                Grid.Row="0"
                Grid.RowSpan="2"
                PortfolioName="{Binding _portfolioService.CurrentPortfolio.Name}"
                ViewTitle="{Binding ViewTitle}"
                ExplainerText="{Binding ExplainerText}"
                ShowPortfolioTotals="False"/>


            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1" VerticalAlignment="Stretch">
                <!-- Portfolio Section -->
                <Grid Grid.Row="1" Margin="10,-60,10,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- Portfolio Section Heading -->
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,8,8"
                            Style="{StaticResource AdminSectionBorderStyle}">

                        <TextBlock Text="Portfolios"
                                   Style="{StaticResource AdminSectionTitleStyle}"
                                   Margin="4,0"/>

                    </Border>


                    <!-- Portfolio CommandBar -->
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            Style="{StaticResource AdminSectionBorderStyle}"
                            Padding="0">

                        <CommandBar IsDynamicOverflowEnabled="True" 
                                    DefaultLabelPosition="Right"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center">

                            <AppBarButton Icon="Add"
                                          l:Uids.Uid="PortfolioAdmin_AddButton"
                                          Command="{Binding AddPortfolioCommand}"
                                          CommandParameter="{Binding SelectedItem, ElementName=PortfolioListView}"/>

                            <AppBarButton Icon="Edit"
                                          l:Uids.Uid="PortfolioAdmin_RenameButton"
                                          Command="{Binding RenamePortfolioCommand}"
                                          CommandParameter="{Binding SelectedItem, ElementName=PortfolioListView}"/>

                            <AppBarButton Icon="Copy"
                                          l:Uids.Uid="PortfolioAdmin_CopyButton"
                                          Command="{Binding CopyPortfolioCommand}"
                                          CommandParameter="{Binding SelectedItem, ElementName=PortfolioListView}"/>

                            <AppBarButton x:Name="DeleteFlyoutAbb"
                                          Icon="Delete"
                                          l:Uids.Uid="PortfolioAdmin_DeleteButton"
                                          Command="{Binding DeletePortfolioDummyCommand}"
                                          CommandParameter="{Binding SelectedPortfolio}">

                                <AppBarButton.Flyout>
                                    <Flyout x:Name="DeleteFlyout"
                                            x:FieldModifier="public">

                                        <StackPanel>
                                            <Grid MaxWidth="300">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Style="{ThemeResource BaseTextBlockStyle}"
                                                           l:Uids.Uid="PortfolioAdmin_PreName"
                                                           Margin="0,0,3,12"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Grid.Row="1"
                                                           Style="{ThemeResource BaseTextBlockStyle}"
                                                           FontStyle="Oblique"
                                                           Text="{Binding SelectedPortfolio.Name}"
                                                           Margin="0,0,3,12"/>

                                                <TextBlock Grid.Row="2"
                                                           Style="{ThemeResource BaseTextBlockStyle}"
                                                           l:Uids.Uid="PortfolioAdmin_PostName"
                                                           Margin="0,0,0,12"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                            <Button x:Name="btnDelete"
                                                Command="{Binding DeletePortfolioCommand}"
                                                CommandParameter="{Binding SelectedPortfolio}"
                                                l:Uids.Uid="PortfolioAdmin_DeleteConfirm"
                                                HorizontalAlignment="Center" 
                                                Click="CloseFlyoutDelete"/>
                                        </StackPanel>

                                    </Flyout>
                                </AppBarButton.Flyout>

                            </AppBarButton>

                            <AppBarSeparator/>

                            <AppBarButton x:Name="tbSaveBackup"
                                          Icon="Save"
                                          l:Uids.Uid="PortfolioAdmin_SaveBackupButton"
                                          Command="{Binding BackupPortfolioCommand}"
                                          CommandParameter="{Binding SelectedPortfolio}"/>

                            <AppBarButton x:Name="tbRestoreBackup"
                                          Icon="OpenFile"
                                          l:Uids.Uid="PortfolioAdmin_RestoreBackupButton"
                                          Command="{Binding BrowseAndRestorePortfolioCommand}"/>

                            <AppBarToggleButton x:Name="tbShowRestore"
                                                Icon="Bullets"
                                                l:Uids.Uid="PortfolioAdmin_ShowRestoreButton"/>

                        </CommandBar>

                    </Border>


                    <!-- Portfolio List -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,10"
                            Style="{StaticResource AdminSectionBorderStyle}"
                            Padding="4">

                        <ListView x:Name="PortfolioListView"
                                  ItemsSource="{Binding ListPortfolios}"
                                  SelectedItem="{Binding SelectedPortfolio, Mode=TwoWay}"
                                  Loaded="PortfolioListView_Loaded"
                                  SelectionChanged="PortfolioListView_SelectionChanged"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                  ScrollViewer.VerticalScrollMode="Enabled"
                                  toolkit:ScrollBarExtensions.KeepVerticalExpanded="True"
                                  BorderThickness="0"
                                  ItemContainerStyle="{StaticResource CustomListViewItemsStyle}"
                                  IsItemClickEnabled="False"
                                  SelectionMode="Single"
                                  CanReorderItems="False"
                                  AllowDrop="False">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0">
                                        <TextBlock
                                            Grid.Row="0"
                                            Text="{Binding Name}"
                                            ToolTipService.ToolTip="{Binding Signature}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                            TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </Border>

                </Grid>
                <!-- End of Portfolio Section -->
            </Border>

            <!-- Restore Points Section -->
            <Grid Grid.Row="2"
                  Visibility="{x:Bind converters:Functions.TrueToVisible(tbShowRestore.IsChecked), Mode=OneWay}"
                  Margin="10,10,10,5">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- Restore Points Heading and Commands -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,8,0"
                            Style="{StaticResource AdminSectionBorderStyle}">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock l:Uids.Uid="PortfolioAdmin_RestoreTitle"
                                       FontWeight="SemiBold"
                                       Margin="4,0,3,0"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding SelectedItem.Name, ElementName=PortfolioListView}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>


                    <Border Grid.Column="1"
                            Style="{StaticResource AdminSectionBorderStyle}"
                            Padding="0">

                        <CommandBar Background="Transparent"
                                    IsOpen="False"
                                    IsDynamicOverflowEnabled="True"
                                    DefaultLabelPosition="Right"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center">

                            <AppBarButton x:Name="RestoreFlyoutAbb"
                                          Icon="Repair"
                                          l:Uids.Uid="PortfolioAdmin_RestoreButton"
                                          Command="{Binding RestorePortfolioDummyCommand}"
                                          CommandParameter="{Binding SelectedItem, ElementName=PortfolioListView}">

                                <AppBarButton.Flyout>
                                    <Flyout x:Name="RestoreFlyoutDelete"
                                            x:FieldModifier="public">

                                        <StackPanel>
                                            <Grid MaxWidth="300">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="1"
                                                           Style="{ThemeResource BaseTextBlockStyle}"
                                                           FontStyle="Oblique"
                                                           Text="{Binding SelectedPortfolio.Name}"
                                                           Margin="0,0,3,12"/>

                                                <TextBlock Grid.Row="2"
                                                           Style="{ThemeResource BaseTextBlockStyle}"
                                                           l:Uids.Uid="PortfolioAdmin_RestoreMidName"
                                                           Margin="0,0,3,12"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Grid.Row="3"
                                                           Style="{ThemeResource BaseTextBlockStyle}"
                                                           FontStyle="Oblique"
                                                           Text="{Binding SelectedBackup.FileName}"
                                                           Margin="0,0,3,12"/>

                                                <TextBlock Grid.Row="4"
                                                           Style="{ThemeResource BaseTextBlockStyle}"
                                                           l:Uids.Uid="PortfolioAdmin_RestorePostName"
                                                           Margin="0,0,0,12"
                                                           TextWrapping="Wrap"/>

                                            </Grid>

                                            <Button Command="{Binding RestorePortfolioCommand}"
                                                    CommandParameter="{Binding SelectedPortfolio}"
                                                    l:Uids.Uid="PortfolioAdmin_RestoreConfirm"
                                                    HorizontalAlignment="Center"
                                                    Click="CloseFlyoutRestore"/>

                                        </StackPanel>

                                    </Flyout>
                                </AppBarButton.Flyout>

                            </AppBarButton>

                            <AppBarButton Icon="Delete"
                                          l:Uids.Uid="PortfolioAdmin_DeleteRestoreButton"
                                          Command="{Binding DeleteRestorePointCommand}"
                                          CommandParameter="{Binding SelectedItem, ElementName=BackupListView}"/>

                        </CommandBar>

                    </Border>

                </Grid>


                <!-- Backup List -->
                <Border Grid.Row="1"
                        Style="{StaticResource AdminSectionBorderStyle}"
                        Padding="4">

                    <ListView x:Name="BackupListView"
                              ItemsSource="{Binding Backups}"
                              SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                              Loading="BackupListView_Loading"
                              Loaded="BackupListView_Loaded"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource CustomListViewItemsStyle}"
                              IsItemClickEnabled="False"
                              SelectionMode="Single"
                              toolkit:ScrollBarExtensions.KeepVerticalExpanded="True"
                              CanReorderItems="False"
                              AllowDrop="False">

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:Backup">
                                <Border x:Name="BackupItem"
                                        Background="Transparent">

                                    <RelativePanel>
                                        <TextBlock x:Name="txtName"
                                                   Text="{Binding FileName, Mode=OneWay}"
                                                   Margin="15,0,0,0"/>

                                        <TextBlock Text="{Binding BackupDate, Mode=OneWay}"
                                                   HorizontalAlignment="Right"
                                                   Margin="15,0,20,0"
                                                   RelativePanel.RightOf="txtName"
                                                   RelativePanel.AlignRightWithPanel="True"/>
                                    </RelativePanel>

                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                </Border>

            </Grid>
        </Grid>
        <!-- End of Restore Points Section -->

        <!-- Visual States -->
        <VisualStateManager.VisualStateGroups>

            <VisualStateGroup>

                <VisualState x:Name="Unchecked">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind converters:Functions.InvertBool(tbShowRestore.IsChecked), Mode=OneWay}"/>
                    </VisualState.StateTriggers>

                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames
                            Storyboard.TargetName="Row1"
                            Storyboard.TargetProperty="Height">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                        </ObjectAnimationUsingKeyFrames>

                        <ObjectAnimationUsingKeyFrames
                            Storyboard.TargetName="Row2"
                            Storyboard.TargetProperty="Height">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="Checked">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding ElementName=tbShowRestore, Path=IsChecked}"/>
                    </VisualState.StateTriggers>

                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames
                            Storyboard.TargetName="Row1"
                            Storyboard.TargetProperty="Height">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="0.33*"/>
                        </ObjectAnimationUsingKeyFrames>

                        <ObjectAnimationUsingKeyFrames
                            Storyboard.TargetName="Row2"
                            Storyboard.TargetProperty="Height">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="0.67*"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

            </VisualStateGroup>

        </VisualStateManager.VisualStateGroups>

    </Grid>

</Page>
