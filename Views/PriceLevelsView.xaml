<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CryptoPortfolioTracker.Views.PriceLevelsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CryptoPortfolioTracker.Models"
    xmlns:viewmodels="using:CryptoPortfolioTracker.ViewModels"
    xmlns:converters="using:CryptoPortfolioTracker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:controls="using:CryptoPortfolioTracker.Controls"
    Loaded="View_Loaded"
    Loading="View_Loading"
    Unloaded="View_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="HorizontalSwipe" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <SolidColorBrush x:Key="ProgressRingForeground" Color="#EEBC3F"/>
    </Page.Resources>
    
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!--<ColumnDefinition Width="*"/>-->
        </Grid.ColumnDefinitions>

        <controls:PortfolioHeaderControl
            x:Name="PortfolioHeader"
            Grid.Row="0"
            Grid.RowSpan="2"
            PortfolioName="{Binding PortfolioName}"
            ViewTitle="{Binding ViewTitle}"
            ItemCountText="{x:Bind converters:Functions.AddPrefixAndSuffixToString(_viewModel.CoinsCount,' \(','\)'), Mode=OneWay}"
            ExplainerText="{Binding ExplainerText}"
            ShowPortfolioTotals="False"/>


        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1" VerticalAlignment="Stretch">
            <Grid Name="PriceLevelsContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Actual ListView -->
                <controls:PriceLevelsListViewControl
                    x:Name="MyPriceLevelsListViewControl"
                    Grid.Row="0"
                    x:FieldModifier="public" />

                <!-- Loading overlay -->
                <Grid Grid.Row="0"
                        Canvas.ZIndex="10"
                        Visibility="{x:Bind _viewModel.LoadingVisibility, Mode=OneWay}"
                        Background="#CC202020">

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="18">

                        <ProgressRing
                        Width="55"
                        Height="55"
                        IsActive="{x:Bind _viewModel.IsLoading, Mode=OneWay}"
                        Visibility="Visible"/>

                        <TextBlock
                        Text="Loading price levels..."
                        Foreground="White"
                        FontSize="16"
                        HorizontalAlignment="Center"/>

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
