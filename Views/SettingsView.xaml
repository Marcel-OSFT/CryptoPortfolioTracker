<UserControl
    x:Class="TemperatureMonitor.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:TemperatureMonitor.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="12">

            <!-- Header -->
            <TextBlock Text="Application settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <!-- 2x2 grid of cards (UniformGrid not available in WinUI by default) -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Font Size card (updated Slider for WinUI3: remove IsSnapToTickEnabled) -->
                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Font Size" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Choose the global font size used in the app." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <!-- WinUI Slider: use StepFrequency to control increments; IsSnapToTickEnabled is not available -->
                        <Slider Minimum="0" Maximum="2" StepFrequency="1" TickFrequency="1"
                Value="{Binding FontSize, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" Spacing="12">
                            <TextBlock Text="Small" />
                            <TextBlock Text="Normal" />
                            <TextBlock Text="Large" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- App Theme card -->
                <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="App Theme" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Select application theme." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <ComboBox SelectedIndex="{Binding AppThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="System (Default)" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Number Format card -->
                <Border Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Number Format" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Choose format for decimal and thousand separators." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <ComboBox SelectedIndex="{Binding NumberFormatIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Dutch (1.234,56)" />
                            <ComboBoxItem Content="English (1,234.56)" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- App Culture card -->
                <Border Grid.Row="1" Grid.Column="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="App Language / Culture" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Select language / culture for localized strings and date formats." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <ComboBox SelectedIndex="{Binding AppCultureIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Nederlands (nl)" />
                            <ComboBoxItem Content="English (en-US)" />
                        </ComboBox>
                    </StackPanel>
                </Border>


                <!-- New: Temperature sampling interval cards -->
                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Fast sample rate (seconds) -->
                    <Border Grid.Column="0" Margin="0,12,12,0" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Temperature Sampling — Fast" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Use for rapid sampling (1 to 60 seconds)." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <Slider Minimum="1" Maximum="60" StepFrequency="1" TickFrequency="1"
                        Value="{Binding SampleIntervalFastSeconds, Mode=TwoWay}" Width="220"/>
                                <TextBlock Text="{Binding SampleIntervalFastSeconds}" VerticalAlignment="Center"/>
                                <TextBlock Text="s" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Slow sample rate (minutes) -->
                    <Border Grid.Column="1" Margin="0,12,0,0" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Temperature Sampling — Slow" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Use for power-saving sampling (1 to 60 minutes)." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <Slider Minimum="1" Maximum="60" StepFrequency="1" TickFrequency="1"
                        Value="{Binding SampleIntervalSlowMinutes, Mode=TwoWay}" Width="220"/>
                                <TextBlock Text="{Binding SampleIntervalSlowMinutes}" VerticalAlignment="Center"/>
                                <TextBlock Text="min" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

                <!-- New: Manual ESP IP card -->
                <Border Grid.Row="3" Grid.Column="0" Margin="0,12,0,0" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="ESP32 — Manual IP (optional)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="If the ESP cannot be discovered automatically, enter its IP address here. Example: 192.168.1.42" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="260" PlaceholderText="e.g. 192.168.1.42"
                     Text="{Binding EspIpAddress, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>